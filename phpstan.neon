includes:
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
  level: 6
  paths:
    - src
    - tests
  excludePaths:
    - vendor
    - bin
  autoload_directories:
    - config
  checkMissingIterableValueType: false
  checkGenericClassInNonGenericObjectType: false
  reportUnmatchedIgnoredErrors: true
  ignoreErrors: []

